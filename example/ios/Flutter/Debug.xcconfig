#include "Generated.xcconfig"

// Generated.xcconfig is the source of truth for FLUTTER_TARGET. A normal
// `flutter run` writes lib/main.dart, while `flutter test integration_test/...`
// writes its generated test listener. Overriding it here silently launches the
// example UI instead of the requested integration test.
