{
  "manifest_version": 3,
  "name": "Flutter Vless Companion",
  "description": "Controls a local flutter_vless/Xray companion and routes browser traffic through it.",
  "version": "0.1.0",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "proxy",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flutter Vless"
  }
}
