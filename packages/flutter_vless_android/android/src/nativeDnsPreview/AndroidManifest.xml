<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="${applicationId}.test" />
        <package android:name="com.android.chrome" />
    </queries>
    <application>
        <service
            android:name="com.github.tfox.flutter_vless.xray.service.NativePreviewVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:process=":NativeDnsPreviewDaemon">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="vpn" />
            <intent-filter><action android:name="android.net.VpnService" /></intent-filter>
            <meta-data android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON" android:value="false" />
        </service>
    </application>
</manifest>
