[
  {
    "name": "doh_alias_ipv4",
    "config": {
      "log": {
        "loglevel": "none"
      },
      "inbounds": [],
      "outbounds": [
        {
          "tag": "proxy",
          "protocol": "socks",
          "settings": {
            "servers": [
              {
                "address": "192.0.2.7",
                "port": 1080
              }
            ]
          }
        },
        {
          "tag": "direct",
          "protocol": "freedom"
        },
        {
          "tag": "block",
          "protocol": "blackhole"
        }
      ],
      "routing": {
        "rules": []
      },
      "custom": {
        "canary": "static-alias-caller-data",
        "type": "xicmp",
        "url": "quic+local://literal.invalid",
        "null": null,
        "empty": []
      },
      "remarks": "doh_alias_ipv4",
      "dns": {
        "servers": [
          {
            "address": "https://doh.example/dns-query?caller=kept",
            "tag": "caller-dns",
            "domains": [
              "full:private.example"
            ],
            "skipFallback": true,
            "timeoutMs": 1200
          }
        ],
        "hosts": {
          "full:doh.example": "alias.example",
          "full:alias.example": "192.0.2.53"
        },
        "queryStrategy": "UseIP",
        "disableCache": true,
        "custom": {
          "network": "MiXeD",
          "allowInsecure": "^literal$"
        }
      }
    }
  },
