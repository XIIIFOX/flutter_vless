  {
    "name": "explicit_dual_stack",
    "config": {
      "log": {
        "loglevel": "none"
      },
      "inbounds": [
        {
          "tag": "caller-input",
          "listen": "127.0.0.1",
          "port": 10808,
          "protocol": "socks",
          "settings": {
            "auth": "noauth",
            "udp": true
          },
          "sniffing": {
            "enabled": true,
            "routeOnly": false,
            "destOverride": [
              "tls"
            ]
          }
        }
      ],
      "outbounds": [
        {
          "tag": "proxy",
          "protocol": "http",
          "settings": {
            "address": "endpoint.invalid",
            "port": 443
          }
        },
        {
          "tag": "direct",
          "protocol": "freedom"
        }
      ],
      "dns": {
        "tag": "caller-dns",
        "queryStrategy": "UseIP",
        "hosts": {
          "full:static.invalid": "192.0.2.14"
        },
        "servers": [
          {
            "address": "fakedns",
            "domains": [
              "full:fake.invalid"
            ],
            "skipFallback": true,
            "tag": "caller-fake-dns"
          },
          "tcp://1.1.1.1"
        ]
      },
      "routing": {
        "domainStrategy": "AsIs",
        "rules": [
          {
            "type": "field",
            "inboundTag": [
              "caller-input"
            ],
            "outboundTag": "proxy"
          }
        ]
      },
      "policy": {
        "system": {
          "statsInboundUplink": false,
          "statsInboundDownlink": false
        }
      },
      "FakeDNS": [
        {
          "ipPool": "198.19.0.0/16",
          "poolSize": 1024
        },
        {
          "ipPool": "fc00::/18",
          "poolSize": 1024
        }
      ]
    }
  },
