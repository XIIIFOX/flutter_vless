[
  {
    "name": "implicit_default_ipv4",
    "config": {
      "log": {
        "loglevel": "none"
      },
      "inbounds": [
        {
          "tag": "caller-input",
          "listen": "127.0.0.1",
          "port": 10808,
          "protocol": "socks",
          "settings": {
            "auth": "noauth",
            "udp": true
          },
          "sniffing": {
            "enabled": true,
            "routeOnly": false,
            "destOverride": [
              "tls"
            ]
          }
        }
      ],
      "outbounds": [
        {
          "tag": "proxy",
          "protocol": "http",
          "settings": {
            "address": "endpoint.invalid",
            "port": 443
          }
        },
        {
          "tag": "direct",
          "protocol": "freedom"
        }
      ],
      "dns": {
        "tag": "caller-dns",
        "queryStrategy": "UseIPv4",
        "hosts": {
          "full:static.invalid": "192.0.2.14"
        },
        "servers": [
          "fakedns"
        ]
      },
      "routing": {
        "domainStrategy": "AsIs",
        "rules": [
          {
            "type": "field",
            "inboundTag": [
              "caller-input"
            ],
            "outboundTag": "proxy"
          }
        ]
      },
      "policy": {
        "system": {
          "statsInboundUplink": false,
          "statsInboundDownlink": false
        }
      }
    }
  },
